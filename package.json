{
  "name": "executia-entry",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@executia/execution-intelligence-core": "file:../executia-layer/packages/execution-intelligence-core"
  },
  "engines": { "node": ">=18" },
  "scripts": {
    "postinstall": "node scripts/sync-execution-intelligence-core.mjs",
    "sync:intelligence-core": "node scripts/sync-execution-intelligence-core.mjs",
    "test": "node --test tests/**/*.test.js",
    "test:execution-engine-core": "node --test packages/execution-engine-core/tests/**/*.test.js",
    "demo:execution-engine-core": "node packages/execution-engine-core/examples/complete-cycle.mjs",
    "test:build002": "node --test packages/execution-engine-validation/tests/**/*.test.js",
    "demo:build002": "node packages/execution-engine-validation/examples/run-three-domains.mjs",
    "test:build003": "node --test packages/execution-engine-validation/stress/stress.test.js",
    "demo:build003": "node packages/execution-engine-validation/stress/run-stress.mjs",
    "test:build004": "node --test packages/execution-engine-core/tests/graph-engine.test.js packages/execution-engine-validation/tests/domain-agnostic.test.js packages/execution-engine-validation/stress/stress.test.js",
    "demo:build004": "node packages/execution-engine-validation/examples/run-build004-scenarios.mjs",
    "test:build006": "node --test packages/execution-engine-core/tests/guardian.test.js packages/execution-engine-core/tests/graph-engine.test.js",
    "test:build005": "node --test packages/execution-engine-validation/experiments/build005/build005.test.js",
    "demo:build005": "node packages/execution-engine-validation/experiments/build005/recursive-vs-atomic.mjs",
    "test:build007": "node --test packages/execution-pilot-layer/tests/**/*.test.js",
    "demo:build007": "node packages/execution-pilot-layer/examples/run-pilots.mjs",
    "test:p1-001": "node --test packages/pilot-workspace/tests/**/*.test.js",
    "build:p1-001": "npm --prefix packages/pilot-workspace run build",
    "demo:p1-001": "npm --prefix packages/pilot-workspace run start",
    "test:entry": "node --test tests/entry-fully-ready.test.js",
    "smoke:entry": "node --test tests/entry-smoke.test.js",
    "build:entry": "node scripts/entry-build-verify.mjs",
    "review:entry": "node scripts/entry-review/run-review.mjs",
    "review:entry:visual": "node scripts/entry-review/capture-visual.mjs && node scripts/entry-review/publish-gallery.mjs",
    "review:entry:publish": "node scripts/entry-review/publish-preview.mjs",
    "review:entry:gallery": "node scripts/entry-review/publish-gallery.mjs",
    "verify:preview": "node scripts/entry-review/verify-preview.mjs",
    "verify:production": "node scripts/entry-review/verify-production.mjs",
    "test:web-001": "npm --prefix packages/executia-website run test",
    "build:web-001": "npm --prefix packages/executia-website run build",
    "smoke:web-001": "npm --prefix packages/executia-website run smoke",
    "demo:web-001": "npm --prefix packages/executia-website run start",
    "test:life": "npm --prefix packages/executia-life run test",
    "dev:life": "npm --prefix packages/executia-life run dev",
    "build:life": "npm --prefix packages/executia-life run build",
    "test:core-ai": "npm --prefix packages/executia-core-ai run test",
    "typecheck:core-ai": "npm --prefix packages/executia-core-ai run typecheck"
  }
}
