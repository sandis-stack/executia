{
  "version": 2,
  "functions": {
    "api/**/*.js": { "maxDuration": 15 }
  },
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/llms.txt$", "dest": "/llms.txt" },
    { "src": "^/robots.txt$", "dest": "/robots.txt" },
    { "src": "^/sitemap.xml$", "dest": "/sitemap.xml" },
    { "src": "^/entry$", "dest": "/index.html" },
    { "src": "^/entry/legacy$", "dest": "/index.legacy.html" },
    { "src": "^/engine$", "dest": "/engine.html" },
    { "src": "^/engine/$", "dest": "/engine.html" },
    { "src": "^/docs$", "dest": "/docs.html" },
    { "src": "^/pilot$", "dest": "/pilot.html" },
    { "src": "^/pilot/approved$", "dest": "/pilot-approved.html" },
    { "src": "^/one$", "dest": "/one.html" },
    { "src": "^/proof$", "dest": "/proof.html" },
    { "src": "^/support$", "dest": "/support.html" },
    { "src": "^/request$", "dest": "/request.html" },
    { "src": "^/contact$", "dest": "/contact.html" },
    { "src": "^/privacy$", "dest": "/privacy.html" },
    { "src": "^/terms$", "dest": "/terms.html" },
    { "src": "^/cookies$", "dest": "/cookies.html" },
    { "src": "^/gdpr$", "dest": "/gdpr.html" },
    { "src": "^/life/?$", "dest": "/apps/life/index.html" },
    { "src": "^/life-proof/?$", "dest": "/proofs/life-proof/index.html" },
    { "src": "^/invoice-proof/?$", "dest": "/proofs/invoice-proof/index.html" },
    { "src": "^/standard$", "dest": "/standard.html" },
    { "src": "^/definition$", "dest": "/definition.html" },
    { "src": "^/global$", "dest": "/global.html" },
    { "src": "^/institutional$", "dest": "/institutional.html" },
    { "src": "^/test$", "status": 302, "headers": { "Location": "https://execution.executia.io/dashboard" } },
    { "src": "^/execution$", "status": 302, "headers": { "Location": "https://executia.io/engine" } },
    { "src": "^/dashboard$", "status": 302, "headers": { "Location": "https://execution.executia.io/dashboard" } },
    { "src": "^/api/request$", "dest": "/api/request.js" }
  ]
}
